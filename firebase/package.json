{
  "name": "festival-pub-firebase",
  "version": "0.3.0",
  "private": true,
  "description": "축제 주점 Firebase 보안 규칙·에뮬레이터·테스트 도구",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-festival-pub",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-festival-pub \"node --test test/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.2"
  }
}
