rules_version = '2';

// 축제 주점 — Firestore 보안 규칙 (docs/FIREBASE.md 6장)
//
// - 읽기·쓰기는 "스태프 공용 계정(이메일/비밀번호)"으로 로그인한 관리자 앱만 허용한다.
//   계정 이메일을 바꾸면 아래 STAFF_EMAIL 과 앱의 Fs.STAFF_EMAIL 을 같이 바꾼다.
// - 친구의 서버들(웨이팅 등록, 입금확인, QR 주문)은 Admin SDK 를 쓴다고 가정한다 → 이 규칙을 우회한다. 🔶 친구 확인 필요
// - 앱은 허용된 필드·상태 전이만 쓸 수 있다. orders.paymentStatus 는 절대 못 바꾼다.

service cloud.firestore {
  match /databases/{db}/documents {

    function staff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'staff@festival-pub.local'; // = STAFF_EMAIL
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function only(keys) { return changed().hasOnly(keys); }
    function isNow(v) { return v == request.time; }
    function tableDoc(no) { return /databases/$(db)/documents/tables/$(string(no)); }
    function counterDoc(name) { return /databases/$(db)/documents/counters/$(name); }
    function active() { return ['WAITING', 'CALLED', 'NO_SHOW']; }

    // ---------------- 설정·스태프·메뉴 ----------------
    match /config/staff { allow read: if staff(); }

    match /config/settings {
      allow read: if staff();
      // 앱은 시간 3종만. rows/cols(배치)는 서버 쪽이 관리
      allow update: if staff()
        && only(['rotationMinutes', 'imminentMinutes', 'noShowMinutes', 'updatedBy', 'updatedAt'])
        && request.resource.data.rotationMinutes is int
        && request.resource.data.rotationMinutes >= 30 && request.resource.data.rotationMinutes <= 240
        && request.resource.data.imminentMinutes is int
        && request.resource.data.imminentMinutes >= 5 && request.resource.data.imminentMinutes <= 60
        && request.resource.data.noShowMinutes is int
        && request.resource.data.noShowMinutes >= 1 && request.resource.data.noShowMinutes <= 10
        && isNow(request.resource.data.updatedAt);
    }

    match /menu/{id} { allow read: if staff(); }

    // ---------------- 테이블 ----------------
    // 문서 생성·삭제(배치 변경)는 서버 쪽. 앱은 착석·연장·종료만.
    match /tables/{no} {
      allow read: if staff();
      allow update: if staff() && isNow(request.resource.data.updatedAt) && (
        // 착석: EMPTY → OCCUPIED, 착석 시각은 서버 시각, 연장 0
        (resource.data.status == 'EMPTY' && request.resource.data.status == 'OCCUPIED'
          && isNow(request.resource.data.seatedAt) && request.resource.data.extendedMinutes == 0
          && only(['status', 'seatedAt', 'extendedMinutes', 'partySize', 'phone', 'waitingId', 'waitingIsVip',
                   'updatedBy', 'updatedAt']))
        // 연장: 이용 중일 때 10/20/30분만
        || (resource.data.status == 'OCCUPIED' && request.resource.data.status == 'OCCUPIED'
          && only(['extendedMinutes', 'updatedBy', 'updatedAt'])
          && (request.resource.data.extendedMinutes - resource.data.extendedMinutes) in [10, 20, 30])
        // 이용 종료: OCCUPIED → EMPTY, 착석 정보 초기화 (주문은 건드리지 않음)
        || (resource.data.status == 'OCCUPIED' && request.resource.data.status == 'EMPTY'
          && request.resource.data.seatedAt == null && request.resource.data.waitingId == null
          && request.resource.data.extendedMinutes == 0
          && only(['status', 'seatedAt', 'extendedMinutes', 'partySize', 'phone', 'waitingId', 'waitingIsVip',
                   'updatedBy', 'updatedAt']))
      );
    }

    // ---------------- 웨이팅 ----------------
    // 호출·무응답·복귀·취소·착석 상태 전이 (일반/VIP 공통). isVip = 이 문서가 vipWaitings 인지
    function waitingUpdateOk(id, isVip) {
      let d = request.resource.data;
      let o = resource.data;
      return staff()
        && only(['status', 'calledAt', 'tableNo', 'updatedBy', 'updatedAt'])
        && isNow(d.updatedAt)
        && (
          (d.status == 'CALLED' && o.status in ['WAITING', 'CALLED'] && isNow(d.calledAt))
          || (d.status == 'NO_SHOW' && o.status in ['WAITING', 'CALLED'])
          || (d.status == 'WAITING' && o.status == 'NO_SHOW' && d.calledAt == null)
          || (d.status == 'CANCELLED' && o.status in active())
          // 착석: 같은 트랜잭션에서 그 테이블이 이 웨이팅으로 OCCUPIED 가 될 때만
          || (d.status == 'SEATED' && o.status in active()
            && getAfter(tableDoc(d.tableNo)).data.status == 'OCCUPIED'
            && getAfter(tableDoc(d.tableNo)).data.waitingId == int(id)
            && getAfter(tableDoc(d.tableNo)).data.waitingIsVip == isVip)
        );
    }

    // 일반 손님: 친구 서버(웹 등록)만 생성. 앱은 상태 변경만.
    match /waitings/{id} {
      allow read: if staff();
      allow update: if waitingUpdateOk(id, false);
    }

    // VIP: 앱만 생성·수정 (서버/웹은 읽지도 쓰지도 않음). 번호는 counters/vip 로 매긴다.
    match /vipWaitings/{id} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.keys().hasOnly(['id', 'phone', 'partySize', 'isVip', 'status', 'createdAt',
                                                 'calledAt', 'tableNo', 'createdBy', 'updatedBy', 'updatedAt'])
        && request.resource.data.id == int(id)
        && request.resource.data.isVip == true
        && request.resource.data.status == 'WAITING'
        && request.resource.data.phone is string
        && request.resource.data.partySize is int && request.resource.data.partySize >= 1
        && isNow(request.resource.data.createdAt)
        && getAfter(counterDoc('vip')).data.next == int(id) + 1;
      allow update: if waitingUpdateOk(id, true);
    }

    // ---------------- 주문 ----------------
    match /orders/{id} {
      // 앱은 입금확인(PAID)된 주문만 읽는다. 쿼리에도 paymentStatus == 'PAID' 조건이 있어야 통과.
      allow read: if staff() && resource.data.paymentStatus == 'PAID';
      // 1-5 직원 주문: PENDING 으로만, 착석한 테이블만, 주문번호는 counters/orders 로
      allow create: if staff()
        && request.resource.data.keys().hasOnly(['id', 'tableNo', 'items', 'total', 'source', 'paymentStatus',
                                                 'cookStatus', 'createdAt', 'addedBy', 'paidAt', 'paidBy',
                                                 'cookedAt', 'cookedBy'])
        && request.resource.data.id == int(id)
        && request.resource.data.source == 'STAFF'
        && request.resource.data.paymentStatus == 'PENDING'
        && request.resource.data.cookStatus == 'WAITING'
        && request.resource.data.paidAt == null && request.resource.data.cookedAt == null
        && request.resource.data.items is list && request.resource.data.items.size() > 0
        && isNow(request.resource.data.createdAt)
        && get(tableDoc(request.resource.data.tableNo)).data.status == 'OCCUPIED'
        && getAfter(counterDoc('orders')).data.next == int(id) + 1;
      // 조리완료만. paymentStatus 는 절대 못 바꿈
      allow update: if staff()
        && resource.data.paymentStatus == 'PAID' && resource.data.cookStatus == 'WAITING'
        && only(['cookStatus', 'cookedAt', 'cookedBy'])
        && request.resource.data.cookStatus == 'DONE'
        && isNow(request.resource.data.cookedAt);
    }

    // ---------------- 카운터 ----------------
    // vip: 앱 전용. orders: QR 주문 웹과 공유(양쪽 모두 트랜잭션으로 +1). waitings: 친구 서버 전용 → 앱 접근 불가
    match /counters/{name} {
      allow read: if staff() && name in ['vip', 'orders'];
      allow create: if staff() && name in ['vip', 'orders']
        && request.resource.data.keys().hasOnly(['next']) && request.resource.data.next == 2;
      allow update: if staff() && name in ['vip', 'orders']
        && only(['next']) && request.resource.data.next == resource.data.next + 1;
    }

    // ---------------- 기기 시계 보정 ----------------
    match /clocks/{uid} {
      allow read, write: if staff() && request.auth.uid == uid;
    }
  }
}
