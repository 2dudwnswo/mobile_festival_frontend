rules_version = '2';
// 에뮬레이터 전용. v2 스펙 3장의 권한표를 흉내 낸다. 운영 규칙 원본이 아니다.
service cloud.firestore {
  match /databases/{database}/documents {
    function staff() { return request.auth != null; }
    match /tables/{id} { allow read, write: if staff(); }
    match /menu/{id} { allow read: if true; allow write: if staff(); }
    match /orders/{id} { allow read, write: if staff(); }
    match /waiting/{id} {
      allow read: if true;
      allow create: if staff() || request.resource.data.is_vip == false;
      allow update, delete: if staff();
    }
  }
}
